# Normalise line endings: this repo is authored on Windows but runs on Colab (Linux).
# Text files are stored with LF in the repo and checked out with the platform default.
* text=auto

# Always LF — these are executed or parsed on Linux.
*.py      text eol=lf
*.ipynb   text eol=lf
*.sh      text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# These frozen evidence files are hashed byte-for-byte by formal run reports.
# Git's `binary` macro disables text conversion, diff, and merge so their issued
# SHA256 values survive Windows/Linux checkouts and source archives unchanged.
splits/split_manifest.json     binary
splits/defect_types.json       binary
splits/fewshot_selection.json  binary
splits/test_blocklist.json     binary
splits/source_checksums.json   binary
splits/*.sha256                binary

# Binary
*.png     binary
*.jpg     binary
*.JPG     binary
*.gif     binary
*.pdf     binary
*.pptx    binary
