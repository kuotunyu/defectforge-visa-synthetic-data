# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*credentials*
*secret*
*.pem
kaggle.json

# --- Large data & outputs ---
# Bulk data actually lives on D:\sdg-data\01-defectforge (see configs/paths.yaml);
# these rules exist so an accidental local copy never reaches git.
# Leading "/" anchors them to the repo root — an unanchored "data/" would also
# swallow src/data/, which is source code.
/data/
/runs/
/logs/
# Local M7 smoke/determinism contact sheets. The canonical 1,000-sample grids
# are named stageA_copypaste_grid_<object>.png and remain tracked.
/reports/figures/stageA_copypaste_*_grid_*.png
/reports/figures/stageA_procedural*_smoke*_grid_*.png
/reports/stageA_procedural*_smoke*_report.md
/reports/figures/placements_smoke*_check_*.png
/reports/placements_smoke*_report.md
/reports/placements_smoke*_validation.json
/reports/figures/placements_det_*_check_*.png
/reports/placements_det_*_report.md
# Local M12 diffusion calibration, determinism, and validator grids. Formal
# original/searched/comparison figures do not contain "smoke" and remain tracked.
/reports/figures/diffusion_*smoke*.png
/reports/stageB_sd2*smoke*.json
# Per-object checkpoints used while the other object still occupies the GPU.
# The canonical combined original/searched validation JSON remains tracked.
/reports/stageB_sd2_*_pcb1_validation.json
/reports/stageB_sd2_*_capsules_validation.json
# Ephemeral M24 checkpoint audit. The tracked one-page acceptance report is
# generated only after every non-publication gate passes.
/reports/publish_validation.json
# results/ must stay tracked as a directory so results/colab/.gitkeep survives:
# ignore its CONTENTS, not the directory itself.
/results/*
!/results/generation_quality.csv
!/results/classification.csv
!/results/segmentation.csv
!/results/colab/
/results/colab/*
!/results/colab/.gitkeep

*.tar
*.tar.gz
*.zip

# --- Model weights ---
*.ckpt
*.safetensors
*.pt
*.pth
*.onnx

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# --- Tooling / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
